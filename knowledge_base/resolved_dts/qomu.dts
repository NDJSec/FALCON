/dts-v1/;

/* node '/' defined in zephyr/dts/common/skeleton.dtsi:9 */
/ {
	#address-cells = < 0x1 >;         /* in zephyr/dts/common/skeleton.dtsi:10 */
	#size-cells = < 0x1 >;            /* in zephyr/dts/common/skeleton.dtsi:11 */
	model = "QuickLogic Qomu board";  /* in zephyr/boards/quicklogic/qomu/qomu.dts:13 */
	compatible = "quicklogic,eos_s3"; /* in zephyr/boards/quicklogic/qomu/qomu.dts:14 */

	/* node '/chosen' defined in zephyr/dts/common/skeleton.dtsi:13 */
	chosen {
		zephyr,sram = &sram0;       /* in zephyr/boards/quicklogic/qomu/qomu.dts:17 */
		zephyr,console = &uart1;    /* in zephyr/boards/quicklogic/qomu/qomu.dts:18 */
		zephyr,shell-uart = &uart1; /* in zephyr/boards/quicklogic/qomu/qomu.dts:19 */
		zephyr,uart-pipe = &uart1;  /* in zephyr/boards/quicklogic/qomu/qomu.dts:20 */
	};

	/* node '/aliases' defined in zephyr/dts/common/skeleton.dtsi:15 */
	aliases {
		led0 = &blue_led;  /* in zephyr/boards/quicklogic/qomu/qomu.dts:24 */
		led1 = &green_led; /* in zephyr/boards/quicklogic/qomu/qomu.dts:25 */
		led2 = &red_led;   /* in zephyr/boards/quicklogic/qomu/qomu.dts:26 */
		sw0 = &button0;    /* in zephyr/boards/quicklogic/qomu/qomu.dts:27 */
