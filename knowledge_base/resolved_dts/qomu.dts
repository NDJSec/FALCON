	/* node '/memory@20000000' defined in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:30 */
	sram0: memory@20000000 {
		compatible = "mmio-sram";     /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:31 */
