	/* node '/soc' defined in zephyr/dts/arm/armv7-m.dtsi:6 */
	soc {
		#address-cells = < 0x1 >;     /* in zephyr/dts/arm/armv7-m.dtsi:7 */
		#size-cells = < 0x1 >;        /* in zephyr/dts/arm/armv7-m.dtsi:8 */
		compatible = "simple-bus";    /* in zephyr/dts/arm/armv7-m.dtsi:9 */
		interrupt-parent = < &nvic >; /* in zephyr/dts/arm/armv7-m.dtsi:10 */
		ranges;                       /* in zephyr/dts/arm/armv7-m.dtsi:11 */

		/* node '/soc/interrupt-controller@e000e100' defined in zephyr/dts/arm/armv7-m.dtsi:13 */
		nvic: interrupt-controller@e000e100 {
			#address-cells = < 0x1 >;            /* in zephyr/dts/arm/armv7-m.dtsi:14 */
			compatible = "arm,v7m-nvic";         /* in zephyr/dts/arm/armv7-m.dtsi:15 */
			reg = < 0xe000e100 0xc00 >;          /* in zephyr/dts/arm/armv7-m.dtsi:16 */
			interrupt-controller;                /* in zephyr/dts/arm/armv7-m.dtsi:17 */
			#interrupt-cells = < 0x2 >;          /* in zephyr/dts/arm/armv7-m.dtsi:18 */
			arm,num-irq-priority-bits = < 0x3 >; /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:75 */
			phandle = < 0x1 >;                   /* in zephyr/dts/arm/armv7-m.dtsi:10 */
		};

		/* node '/soc/timer@e000e010' defined in zephyr/dts/arm/armv7-m.dtsi:21 */
		systick: timer@e000e010 {
			compatible = "arm,armv7m-systick"; /* in zephyr/dts/arm/armv7-m.dtsi:22 */
			reg = < 0xe000e010 0x10 >;         /* in zephyr/dts/arm/armv7-m.dtsi:23 */
		};

		/* node '/soc/uart@40010000' defined in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:42 */
		uart0: uart@40010000 {
			compatible = "arm,pl011";    /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:43 */
			reg = < 0x40010000 0x1000 >; /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:44 */
			clocks = < &uartclk >;       /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:45 */
			interrupts = < 0x7 0x3 >;    /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:46 */
			interrupt-names = "rx";      /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:47 */
			status = "disabled";         /* in zephyr/boards/quicklogic/qomu/qomu.dts:106 */
		};

		/* node '/soc/uart@40020000' defined in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:50 */
		uart1: uart@40020000 {
			compatible = "quicklogic,usbserialport-s3b";                                                         /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:51 */
			reg = < 0x40020000 0x1000 >;                                                                         /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:52 */
			status = "okay";                                                                                     /* in zephyr/boards/quicklogic/qomu/qomu.dts:110 */
			current-speed = < 0x1c200 >;                                                                         /* in zephyr/boards/quicklogic/qomu/qomu.dts:111 */
			pinctrl-0 = < &uart1_rx_default &uart1_tx_default &usb_pu_default &usb_dn_default &usb_dp_default >; /* in zephyr/boards/quicklogic/qomu/qomu.dts:112 */
			pinctrl-names = "default";                                                                           /* in zephyr/boards/quicklogic/qomu/qomu.dts:114 */
		};

		/* node '/soc/gpio@40005000' defined in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:56 */
		gpio: gpio@40005000 {
			compatible = "quicklogic,eos-s3-gpio"; /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:57 */
			reg = < 0x40005000 0x1000 >;           /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:58 */
			interrupts = < 0x5 0x2 >;              /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:60 */
			#gpio-cells = < 0x2 >;                 /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:61 */
			ngpios = < 0x8 >;                      /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:62 */
			pin-secondary-config = < 0x0 >;        /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:63 */
			gpio-controller;                       /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:64 */
			status = "okay";                       /* in zephyr/boards/quicklogic/qomu/qomu.dts:102 */
			phandle = < 0x8 >;                     /* in zephyr/boards/quicklogic/qomu/qomu.dts:34 */
		};

		/* node '/soc/pinctrl@40004c00' defined in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:67 */
		pinctrl: pinctrl@40004c00 {
			compatible = "quicklogic,eos-s3-pinctrl"; /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:68 */
			reg = < 0x40004c00 0x1b0 >;               /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:69 */

			/* node '/soc/pinctrl@40004c00/uart1_rx_default' defined in zephyr/boards/quicklogic/qomu/qomu.dts:65 */
			uart1_rx_default: uart1_rx_default {
				pinmux = < 0x2d 0x9a004 >; /* in zephyr/boards/quicklogic/qomu/qomu.dts:66 */
				input-enable;              /* in zephyr/boards/quicklogic/qomu/qomu.dts:67 */
				phandle = < 0x3 >;         /* in zephyr/boards/quicklogic/qomu/qomu.dts:112 */
			};

			/* node '/soc/pinctrl@40004c00/uart1_tx_default' defined in zephyr/boards/quicklogic/qomu/qomu.dts:70 */
			uart1_tx_default: uart1_tx_default {
				pinmux = < 0x2c 0x3 >; /* in zephyr/boards/quicklogic/qomu/qomu.dts:71 */
				output-enable;         /* in zephyr/boards/quicklogic/qomu/qomu.dts:72 */
				phandle = < 0x4 >;     /* in zephyr/boards/quicklogic/qomu/qomu.dts:112 */
			};

			/* node '/soc/pinctrl@40004c00/usb_pu_default' defined in zephyr/boards/quicklogic/qomu/qomu.dts:75 */
			usb_pu_default: usb_pu_default {
				pinmux = < 0x17 0x0 >;                   /* in zephyr/boards/quicklogic/qomu/qomu.dts:76 */
				bias-high-impedance;                     /* in zephyr/boards/quicklogic/qomu/qomu.dts:77 */
				quicklogic,control-selection = "fabric"; /* in zephyr/boards/quicklogic/qomu/qomu.dts:78 */
				output-enable;                           /* in zephyr/boards/quicklogic/qomu/qomu.dts:79 */
				phandle = < 0x5 >;                       /* in zephyr/boards/quicklogic/qomu/qomu.dts:112 */
			};

			/* node '/soc/pinctrl@40004c00/usb_dn_default' defined in zephyr/boards/quicklogic/qomu/qomu.dts:82 */
			usb_dn_default: usb_dn_default {
				pinmux = < 0x1c 0x0 >;                   /* in zephyr/boards/quicklogic/qomu/qomu.dts:83 */
				bias-high-impedance;                     /* in zephyr/boards/quicklogic/qomu/qomu.dts:84 */
				quicklogic,control-selection = "fabric"; /* in zephyr/boards/quicklogic/qomu/qomu.dts:85 */
				output-enable;                           /* in zephyr/boards/quicklogic/qomu/qomu.dts:86 */
				phandle = < 0x6 >;                       /* in zephyr/boards/quicklogic/qomu/qomu.dts:112 */
			};

			/* node '/soc/pinctrl@40004c00/usb_dp_default' defined in zephyr/boards/quicklogic/qomu/qomu.dts:89 */
			usb_dp_default: usb_dp_default {
				pinmux = < 0x1f 0x0 >;                   /* in zephyr/boards/quicklogic/qomu/qomu.dts:90 */
				bias-high-impedance;                     /* in zephyr/boards/quicklogic/qomu/qomu.dts:91 */
				quicklogic,control-selection = "fabric"; /* in zephyr/boards/quicklogic/qomu/qomu.dts:92 */
				output-enable;                           /* in zephyr/boards/quicklogic/qomu/qomu.dts:93 */
				phandle = < 0x7 >;                       /* in zephyr/boards/quicklogic/qomu/qomu.dts:112 */
			};
		};
	};

