		clock-frequency = < 0x4e2000 >; /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:37 */
		#clock-cells = < 0x0 >;         /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:38 */
		phandle = < 0x2 >;              /* in zephyr/dts/arm/quicklogic/quicklogic_eos_s3.dtsi:45 */
