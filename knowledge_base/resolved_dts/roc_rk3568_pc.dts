		/* node '/cpus/cpu@300' defined in zephyr/dts/arm64/rockchip/rk3568.dtsi:45 */
		cpu@300 {
			device_type = "cpu";           /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:46 */
			compatible = "arm,cortex-a55"; /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:47 */
			enable-method = "psci";        /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:48 */
