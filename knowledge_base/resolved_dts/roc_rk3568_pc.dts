	};

	/* node '/cpus' defined in zephyr/dts/arm64/rockchip/rk3568.dtsi:20 */
	cpus {
		#address-cells = < 0x1 >; /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:21 */
		#size-cells = < 0x0 >;    /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:22 */

		/* node '/cpus/cpu@000' defined in zephyr/dts/arm64/rockchip/rk3568.dtsi:24 */
		cpu@000 {
			device_type = "cpu";           /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:25 */
			compatible = "arm,cortex-a55"; /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:26 */
