	#size-cells = < 0x1 >;           /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:15 */
	interrupt-parent = < &gic >;     /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:18 */
