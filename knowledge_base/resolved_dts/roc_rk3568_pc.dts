			reg = < 0x0 >;                 /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:28 */
		};

		/* node '/cpus/cpu@100' defined in zephyr/dts/arm64/rockchip/rk3568.dtsi:31 */
		cpu@100 {
			device_type = "cpu";           /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:32 */
			compatible = "arm,cortex-a55"; /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:33 */
			enable-method = "psci";        /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:34 */
			reg = < 0x100 >;               /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:35 */
		};

		/* node '/cpus/cpu@200' defined in zephyr/dts/arm64/rockchip/rk3568.dtsi:38 */
		cpu@200 {
			device_type = "cpu";           /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:39 */
			compatible = "arm,cortex-a55"; /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:40 */
