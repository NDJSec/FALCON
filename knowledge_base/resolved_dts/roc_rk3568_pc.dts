		zephyr,shell-uart = &uart2; /* in zephyr/boards/firefly/roc_rk3568_pc/roc_rk3568_pc.dts:18 */
		zephyr,sram = &sram0;       /* in zephyr/boards/firefly/roc_rk3568_pc/roc_rk3568_pc.dts:19 */
