		             < 0x1 0xa 0x2 0xa0 >; /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:71 */
		interrupt-parent = < &gic >;       /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:75 */
