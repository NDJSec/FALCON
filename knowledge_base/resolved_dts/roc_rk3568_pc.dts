		current-speed = < 0x16e360 >;        /* in zephyr/boards/firefly/roc_rk3568_pc/roc_rk3568_pc.dts:31 */
	};

	/* node '/memory@40000000' defined in zephyr/boards/firefly/roc_rk3568_pc/roc_rk3568_pc.dts:22 */
	sram0: memory@40000000 {
