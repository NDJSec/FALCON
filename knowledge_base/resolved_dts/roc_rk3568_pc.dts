		#interrupt-cells = < 0x4 >;   /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:56 */
		interrupt-controller;         /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:57 */
		reg = < 0xfd400000 0x10000 >,
		      < 0xfd460000 0xc0000 >; /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:59 */
		status = "okay";              /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:61 */
