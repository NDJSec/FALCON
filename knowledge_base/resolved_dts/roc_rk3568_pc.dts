	/* node '/interrupt-controller@fd400000' defined in zephyr/dts/arm64/rockchip/rk3568.dtsi:53 */
	gic: interrupt-controller@fd400000 {
		#address-cells = < 0x1 >;     /* in zephyr/dts/arm64/rockchip/rk3568.dtsi:54 */
		compatible = "arm,gic-v3",
