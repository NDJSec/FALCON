			reg = < 0x40002000 0x1000 >;     /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:67 */
			interrupts = < 0xa 0x3 >;        /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:68 */
			clocks = < &syscon >;            /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:69 */
