			reg = < 0x40004000 0x1000 >;    /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:74 */
			interrupts = < 0x0 0x3 >;       /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:75 */
			clocks = < &sysclk &syscon >;   /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:76 */
			current-speed = < 0x1c200 >;    /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:77 */
			pinctrl-0 = < &uart0_default >; /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:78 */
