			reg = < 0x40013000 0x1000 >;   /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:127 */
			interrupts = < 0x2b 0x3 >;     /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:128 */
			gpio-controller;               /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:129 */
