		/* node '/soc/uart@40005000' defined in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:82 */
		uart1: uart@40005000 {
			compatible = "arm,cmsdk-uart";  /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:83 */
			reg = < 0x40005000 0x1000 >;    /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:84 */
			interrupts = < 0x2 0x3 >;       /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:85 */
			clocks = < &sysclk &syscon >;   /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:86 */
			current-speed = < 0x1c200 >;    /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:87 */
			pinctrl-0 = < &uart1_default >; /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:88 */
			pinctrl-names = "default";      /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:89 */
		};

		/* node '/soc/wdog@40008000' defined in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:92 */
		wdog0: wdog@40008000 {
			compatible = "arm,cmsdk-watchdog"; /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:93 */
			clocks = < &sysclk >;              /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:94 */
			reg = < 0x40008000 0x1000 >;       /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:95 */
