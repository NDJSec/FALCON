			#clock-cells = < 0x0 >;       /* in zephyr/dts/arm/microchip/sam/sama7d6.dtsi:37 */
			clock-frequency = < 0x8000 >; /* in zephyr/boards/microchip/sam/sama7d65_curiosity/sama7d65_curiosity.dts:30 */
			phandle = < 0x3 >;            /* in zephyr/dts/arm/microchip/sam/sama7d6.dtsi:63 */
