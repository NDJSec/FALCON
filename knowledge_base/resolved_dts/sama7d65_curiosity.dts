	/* node '/clocks' defined in zephyr/dts/arm/microchip/sam/sama7d6.dtsi:29 */
	clocks {

		/* node '/clocks/main_xtal' defined in zephyr/dts/arm/microchip/sam/sama7d6.dtsi:30 */
		main_xtal: main_xtal {
			compatible = "fixed-clock";      /* in zephyr/dts/arm/microchip/sam/sama7d6.dtsi:31 */
			#clock-cells = < 0x0 >;          /* in zephyr/dts/arm/microchip/sam/sama7d6.dtsi:32 */
			clock-frequency = < 0x16e3600 >; /* in zephyr/boards/microchip/sam/sama7d65_curiosity/sama7d65_curiosity.dts:26 */
			phandle = < 0x2 >;               /* in zephyr/dts/arm/microchip/sam/sama7d6.dtsi:56 */
