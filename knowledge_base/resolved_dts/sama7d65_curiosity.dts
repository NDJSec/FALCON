				interrupt-parent = < &gic >;        /* in zephyr/dts/arm/microchip/sam/sama7d6.dtsi:408 */
				interrupts = < 0x0 0x2c 0x2 0xa0 >; /* in zephyr/dts/arm/microchip/sam/sama7d6.dtsi:409 */
				status = "disabled";                /* in zephyr/dts/arm/microchip/sam/sama7d6.dtsi:410 */
			};
		};

		/* node '/soc/interrupt-controller@e8c11000' defined in zephyr/dts/arm/microchip/sam/sama7d6.dtsi:414 */
		gic: interrupt-controller@e8c11000 {
			compatible = "arm,gic-v2",
