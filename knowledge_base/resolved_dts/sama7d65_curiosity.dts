	/* node '/cpus' defined in zephyr/dts/arm/microchip/sam/sama7d6.dtsi:18 */
	cpus {
		#address-cells = < 0x1 >; /* in zephyr/dts/arm/microchip/sam/sama7d6.dtsi:19 */
		#size-cells = < 0x0 >;    /* in zephyr/dts/arm/microchip/sam/sama7d6.dtsi:20 */

		/* node '/cpus/cpu@0' defined in zephyr/dts/arm/microchip/sam/sama7d6.dtsi:22 */
		cpu0: cpu@0 {
