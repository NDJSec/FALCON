			#interrupt-cells = < 0x4 >;  /* in zephyr/dts/arm/microchip/sam/sama7d6.dtsi:418 */
			phandle = < 0x4 >;           /* in zephyr/dts/arm/microchip/sam/sama7d6.dtsi:70 */
		};
