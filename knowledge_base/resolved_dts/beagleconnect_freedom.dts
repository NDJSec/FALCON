			compatible = "arm,cortex-m4";          /* in zephyr/dts/arm/ti/cc13xx_cc26xx.dtsi:25 */
			reg = < 0x0 >;                         /* in zephyr/dts/arm/ti/cc13xx_cc26xx.dtsi:26 */
			cpu-power-states = < &idle &standby >; /* in zephyr/dts/arm/ti/cc13xx_cc26xx.dtsi:27 */
			clock-frequency = < 0x2dc6c00 >;       /* in zephyr/boards/beagle/beagleconnect_freedom/beagleconnect_freedom.dts:123 */
		};

		/* node '/cpus/power-states' defined in zephyr/dts/arm/ti/cc13xx_cc26xx.dtsi:30 */
		power-states {

			/* node '/cpus/power-states/idle' defined in zephyr/dts/arm/ti/cc13xx_cc26xx.dtsi:31 */
			idle: idle {
				compatible = "zephyr,power-state";    /* in zephyr/dts/arm/ti/cc13xx_cc26xx.dtsi:32 */
				power-state-name = "suspend-to-idle"; /* in zephyr/dts/arm/ti/cc13xx_cc26xx.dtsi:33 */
				min-residency-us = < 0x3e8 >;         /* in zephyr/dts/arm/ti/cc13xx_cc26xx.dtsi:34 */
