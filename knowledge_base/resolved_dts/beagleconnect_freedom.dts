	/* node '/cpus' defined in zephyr/dts/arm/ti/cc13xx_cc26xx.dtsi:19 */
	cpus {
		#address-cells = < 0x1 >; /* in zephyr/dts/arm/ti/cc13xx_cc26xx.dtsi:20 */
		#size-cells = < 0x0 >;    /* in zephyr/dts/arm/ti/cc13xx_cc26xx.dtsi:21 */

