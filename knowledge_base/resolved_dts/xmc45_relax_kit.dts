				status = "okay";                                                                                 /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:144 */
				pinctrl-0 = < &eth_p2_4_rxer &eth_p2_2_rxd0 &eth_p2_3_rxd1 &eth_p15_8_clk_rmii &eth_p15_9_crs_dv
				              &eth_p2_5_tx_en &eth_p2_8_txd0 &eth_p2_9_txd1 >;                                   /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:145 */
				pinctrl-names = "default";                                                                       /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:148 */
				rxer-port-ctrl = "P2_4";                                                                         /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:150 */
				rxd0-port-ctrl = "P2_2";                                                                         /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:151 */
				rxd1-port-ctrl = "P2_3";                                                                         /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:152 */
				rmii-rx-clk-port-ctrl = "P15_8";                                                                 /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:153 */
				crs-rx-dv-port-ctrl = "P15_9";                                                                   /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:154 */
				phy-connection-type = "rmii";                                                                    /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:156 */
				phy-handle = < &phy >;                                                                           /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:157 */
