	/* node '/flash_controller@58001000' defined in zephyr/dts/arm/infineon/cat3/xmc/xmc4xxx.dtsi:24 */
	flash_controller: flash_controller@58001000 {
		compatible = "infineon,xmc4xxx-flash-controller"; /* in zephyr/dts/arm/infineon/cat3/xmc/xmc4xxx.dtsi:25 */
		reg = < 0x58001000 0x1400 >;                      /* in zephyr/dts/arm/infineon/cat3/xmc/xmc4xxx.dtsi:26 */
		#address-cells = < 0x1 >;                         /* in zephyr/dts/arm/infineon/cat3/xmc/xmc4xxx.dtsi:27 */
		#size-cells = < 0x1 >;                            /* in zephyr/dts/arm/infineon/cat3/xmc/xmc4xxx.dtsi:28 */
		status = "okay";                                  /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:78 */

		/* node '/flash_controller@58001000/flash@8000000' defined in zephyr/dts/arm/infineon/cat3/xmc/xmc4xxx.dtsi:30 */
		flash0: flash@8000000 {
			reg = < 0x8000000 0x100000 >;             /* in zephyr/dts/arm/infineon/cat3/xmc/xmc4500_F100x1024.dtsi:29 */
			compatible = "infineon,xmc4xxx-nv-flash",
			             "soc-nv-flash";              /* in zephyr/dts/arm/infineon/cat3/xmc/xmc4xxx.dtsi:31 */
			write-block-size = < 0x100 >;             /* in zephyr/dts/arm/infineon/cat3/xmc/xmc4xxx.dtsi:32 */

			/* node '/flash_controller@58001000/flash@8000000/pages_layout' defined in zephyr/dts/arm/infineon/cat3/xmc/xmc4500_F100x1024.dtsi:31 */
			pages_layout: pages_layout {

				/* node '/flash_controller@58001000/flash@8000000/pages_layout/pages_layout_16k' defined in zephyr/dts/arm/infineon/cat3/xmc/xmc4500_F100x1024.dtsi:32 */
				pages_layout_16k: pages_layout_16k {
					pages-count = < 0x8 >;   /* in zephyr/dts/arm/infineon/cat3/xmc/xmc4500_F100x1024.dtsi:33 */
					pages-size = < 0x4000 >; /* in zephyr/dts/arm/infineon/cat3/xmc/xmc4500_F100x1024.dtsi:34 */
				};

				/* node '/flash_controller@58001000/flash@8000000/pages_layout/pages_layout_128k' defined in zephyr/dts/arm/infineon/cat3/xmc/xmc4500_F100x1024.dtsi:37 */
				pages_layout_128k: pages_layout_128k {
					pages-count = < 0x1 >;    /* in zephyr/dts/arm/infineon/cat3/xmc/xmc4500_F100x1024.dtsi:38 */
					pages-size = < 0x20000 >; /* in zephyr/dts/arm/infineon/cat3/xmc/xmc4500_F100x1024.dtsi:39 */
				};

				/* node '/flash_controller@58001000/flash@8000000/pages_layout/pages_layout_256k' defined in zephyr/dts/arm/infineon/cat3/xmc/xmc4500_F100x1024.dtsi:42 */
				pages_layout_256k: pages_layout_256k {
					pages-count = < 0x3 >;    /* in zephyr/dts/arm/infineon/cat3/xmc/xmc4500_F100x1024.dtsi:43 */
					pages-size = < 0x40000 >; /* in zephyr/dts/arm/infineon/cat3/xmc/xmc4500_F100x1024.dtsi:44 */
				};
			};

			/* node '/flash_controller@58001000/flash@8000000/partitions' defined in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:82 */
			partitions {
				compatible = "fixed-partitions"; /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:83 */
				#address-cells = < 0x1 >;        /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:84 */
				#size-cells = < 0x1 >;           /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:85 */

				/* node '/flash_controller@58001000/flash@8000000/partitions/partition@0' defined in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:87 */
				code_partition: partition@0 {
					reg = < 0x0 0x80000 >; /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:88 */
					read-only;             /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:89 */
				};

				/* node '/flash_controller@58001000/flash@8000000/partitions/partition@80000' defined in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:92 */
				storage_partition: partition@80000 {
					label = "storage";         /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:93 */
					reg = < 0x80000 0x80000 >; /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:94 */
				};
			};
		};
	};

