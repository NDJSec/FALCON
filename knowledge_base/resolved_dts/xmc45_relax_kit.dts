				pinctrl-names = "default";                   /* in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:164 */

				/* node '/soc/ethernet@5000c000/mdio/ethernet-phy@0' defined in zephyr/boards/infineon/xmc45_relax_kit/xmc45_relax_kit.dts:166 */
