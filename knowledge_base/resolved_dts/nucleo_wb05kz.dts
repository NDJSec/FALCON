			interrupts = < 0x0 0x0 >;                    /* in zephyr/dts/arm/st/wb0/stm32wb0.dtsi:128 */
			#address-cells = < 0x1 >;                    /* in zephyr/dts/arm/st/wb0/stm32wb0.dtsi:130 */
