				partitions {
					compatible = "fixed-partitions"; /* in zephyr/boards/st/nucleo_wb05kz/nucleo_wb05kz.dts:180 */
					#address-cells = < 0x1 >;        /* in zephyr/boards/st/nucleo_wb05kz/nucleo_wb05kz.dts:181 */
