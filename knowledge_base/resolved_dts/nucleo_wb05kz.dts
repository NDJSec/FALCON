		sw1 = &user_button_2;      /* in zephyr/boards/st/nucleo_wb05kz/nucleo_wb05kz.dts:84 */
		sw2 = &user_button_3;      /* in zephyr/boards/st/nucleo_wb05kz/nucleo_wb05kz.dts:85 */
