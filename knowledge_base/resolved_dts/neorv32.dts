/* node '/' defined in zephyr/dts/common/skeleton.dtsi:9 */
/ {
	#address-cells = < 0x1 >;   /* in zephyr/dts/common/skeleton.dtsi:10 */
	#size-cells = < 0x1 >;      /* in zephyr/dts/common/skeleton.dtsi:11 */
	model = "NEORV32 UP5KDemo"; /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:14 */
	compatible = "neorv32";     /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:15 */

	/* node '/chosen' defined in zephyr/dts/common/skeleton.dtsi:13 */
	chosen {
		zephyr,entropy = &trng;     /* in zephyr/dts/riscv/neorv32.dtsi:15 */
		zephyr,flash = &imem;       /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:32 */
