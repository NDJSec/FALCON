		sw1 = &btn1;          /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:26 */
		sw3 = &btn2;          /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:27 */
		sw4 = &btn3;          /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:28 */
	};

	/* node '/cpus' defined in zephyr/dts/riscv/neorv32.dtsi:18 */
	cpus {
		#address-cells = < 0x1 >; /* in zephyr/dts/riscv/neorv32.dtsi:19 */
		#size-cells = < 0x0 >;    /* in zephyr/dts/riscv/neorv32.dtsi:20 */

		/* node '/cpus/cpu@0' defined in zephyr/dts/riscv/neorv32.dtsi:22 */
		cpu0: cpu@0 {
			compatible = "neorv32,cpu",
			             "riscv";                /* in zephyr/dts/riscv/neorv32.dtsi:23 */
			reg = < 0x0 >;                       /* in zephyr/dts/riscv/neorv32.dtsi:24 */
			device_type = "cpu";                 /* in zephyr/dts/riscv/neorv32.dtsi:25 */
			riscv,isa = "rv32im_zicsr_zifencei"; /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:112 */

			/* node '/cpus/cpu@0/interrupt-controller' defined in zephyr/dts/riscv/neorv32.dtsi:27 */
			intc: interrupt-controller {
				compatible = "riscv,cpu-intc"; /* in zephyr/dts/riscv/neorv32.dtsi:28 */
				interrupt-controller;          /* in zephyr/dts/riscv/neorv32.dtsi:29 */
				#address-cells = < 0x1 >;      /* in zephyr/dts/riscv/neorv32.dtsi:30 */
				#interrupt-cells = < 0x1 >;    /* in zephyr/dts/riscv/neorv32.dtsi:31 */
				phandle = < 0x1 >;             /* in zephyr/dts/riscv/neorv32.dtsi:36 */

				/* node '/cpus/cpu@0/interrupt-controller/firq' defined in zephyr/dts/riscv/neorv32.dtsi:33 */
				firq: firq {
					#address-cells = < 0x1 >;                                                                            /* in zephyr/dts/riscv/neorv32.dtsi:34 */
					interrupt-map-mask = < 0x0 0xffffffff >;                                                             /* in zephyr/dts/riscv/neorv32.dtsi:35 */
					interrupt-map = < 0x0 0x0 &intc 0x0 0x10 0x0 0x1 &intc 0x0 0x11 0x0 0x2 &intc 0x0 0x12 0x0 0x3 &intc
					                  0x0 0x13 0x0 0x4 &intc 0x0 0x14 0x0 0x5 &intc 0x0 0x15 0x0 0x6 &intc 0x0 0x16 0x0
					                  0x7 &intc 0x0 0x17 0x0 0x8 &intc 0x0 0x18 0x0 0x9 &intc 0x0 0x19 0x0 0xa &intc 0x0
					                  0x1a 0x0 0xb &intc 0x0 0x1b 0x0 0xc &intc 0x0 0x1c 0x0 0xd &intc 0x0 0x1d 0x0 0xe
					                  &intc 0x0 0x1e 0x0 0xf &intc 0x0 0x1f >;                                           /* in zephyr/dts/riscv/neorv32.dtsi:36 */
					#interrupt-cells = < 0x1 >;                                                                          /* in zephyr/dts/riscv/neorv32.dtsi:52 */
					phandle = < 0x2 >;                                                                                   /* in zephyr/dts/riscv/neorv32.dtsi:60 */
				};
			};
		};
	};

	/* node '/soc' defined in zephyr/dts/riscv/neorv32.dtsi:58 */
	soc {
		compatible = "simple-bus";    /* in zephyr/dts/riscv/neorv32.dtsi:59 */
		interrupt-parent = < &firq >; /* in zephyr/dts/riscv/neorv32.dtsi:60 */
		#address-cells = < 0x1 >;     /* in zephyr/dts/riscv/neorv32.dtsi:61 */
		#size-cells = < 0x1 >;        /* in zephyr/dts/riscv/neorv32.dtsi:62 */
