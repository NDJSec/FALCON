		/* node '/soc/memory@0' defined in zephyr/dts/riscv/neorv32.dtsi:65 */
		imem: memory@0 {
			compatible = "soc-nv-flash",
			             "mmio-sram";    /* in zephyr/dts/riscv/neorv32.dtsi:66 */
			status = "okay";             /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:120 */
			reg = < 0x0 0x10000 >;       /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:121 */
		};

		/* node '/soc/memory@80000000' defined in zephyr/dts/riscv/neorv32.dtsi:70 */
		dmem: memory@80000000 {
