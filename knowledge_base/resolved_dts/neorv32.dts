			reg = < 0xfff00000 0x10000 >; /* in zephyr/dts/riscv/neorv32.dtsi:84 */
			syscon = < &sysinfo >;        /* in zephyr/dts/riscv/neorv32.dtsi:85 */
			#pwm-cells = < 0x3 >;         /* in zephyr/dts/riscv/neorv32.dtsi:86 */
			status = "okay";              /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:148 */
			phandle = < 0x5 >;            /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:95 */
		};

		/* node '/soc/timer@fff10000' defined in zephyr/dts/riscv/neorv32.dtsi:89 */
		gptmr: timer@fff10000 {
			compatible = "neorv32,gptmr"; /* in zephyr/dts/riscv/neorv32.dtsi:90 */
			status = "disabled";          /* in zephyr/dts/riscv/neorv32.dtsi:91 */
			reg = < 0xfff10000 0x10000 >; /* in zephyr/dts/riscv/neorv32.dtsi:92 */
			interrupts = < 0xc >;         /* in zephyr/dts/riscv/neorv32.dtsi:93 */
			syscon = < &sysinfo >;        /* in zephyr/dts/riscv/neorv32.dtsi:94 */
		};

		/* node '/soc/clint@fff40000' defined in zephyr/dts/riscv/neorv32.dtsi:97 */
		clint: clint@fff40000 {
			compatible = "neorv32,clint",
			             "sifive,clint0";        /* in zephyr/dts/riscv/neorv32.dtsi:98 */
			reg = < 0xfff40000 0x10000 >;        /* in zephyr/dts/riscv/neorv32.dtsi:100 */
			interrupts-extended = < &intc 0x3 >; /* in zephyr/dts/riscv/neorv32.dtsi:101 */
