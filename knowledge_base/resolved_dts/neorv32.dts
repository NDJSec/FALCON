			status = "okay";              /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:138 */
			current-speed = < 0x4b00 >;   /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:139 */
