			#gpio-cells = < 0x2 >;        /* in zephyr/dts/riscv/neorv32.dtsi:145 */
			status = "okay";              /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:143 */
			ngpios = < 0x20 >;            /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:144 */
			phandle = < 0x4 >;            /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:43 */
