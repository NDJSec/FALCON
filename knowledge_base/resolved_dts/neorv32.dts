			interrupts-extended = < &intc 0x7 >;     /* in zephyr/dts/riscv/neorv32.dtsi:109 */
			status = "okay";                         /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:134 */
