			reg = < 0x80000000 0x10000 >; /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:126 */
		};

		/* node '/soc/rom@ffe00000' defined in zephyr/dts/riscv/neorv32.dtsi:75 */
		bootrom: rom@ffe00000 {
			compatible = "neorv32,bootrom",
			             "mmio-sram";       /* in zephyr/dts/riscv/neorv32.dtsi:76 */
			reg = < 0xffe00000 0x10000 >;   /* in zephyr/dts/riscv/neorv32.dtsi:78 */
			status = "okay";                /* in zephyr/boards/others/neorv32/neorv32_neorv32_up5kdemo.dts:116 */
		};

		/* node '/soc/pwm@fff00000' defined in zephyr/dts/riscv/neorv32.dtsi:81 */
		pwm: pwm@fff00000 {
