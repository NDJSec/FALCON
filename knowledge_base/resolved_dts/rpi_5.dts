			#address-cells = < 0x3 >;                               /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:121 */
			#size-cells = < 0x2 >;                                  /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:122 */
			ranges = < 0x2000000 0x0 0x0 0x1f 0x0 0x0 0xfffffffc >,
