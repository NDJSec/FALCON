	timer {
		compatible = "arm,armv8-timer";    /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:25 */
		interrupts = < 0x1 0xd 0x2 0xa0 >,
		             < 0x1 0xe 0x2 0xa0 >,
