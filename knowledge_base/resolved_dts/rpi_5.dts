/dts-v1/;

/* node '/' defined in zephyr/dts/common/skeleton.dtsi:9 */
/ {
	interrupt-parent = < &gic >;          /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:22 */
	compatible = "raspberrypi,5-model-b",
	             "brcm,bcm2712";          /* in zephyr/boards/raspberrypi/rpi_5/rpi_5.dts:13 */
	model = "Raspberry Pi 5";             /* in zephyr/boards/raspberrypi/rpi_5/rpi_5.dts:14 */
	#address-cells = < 0x2 >;             /* in zephyr/boards/raspberrypi/rpi_5/rpi_5.dts:15 */
	#size-cells = < 0x1 >;                /* in zephyr/boards/raspberrypi/rpi_5/rpi_5.dts:16 */

	/* node '/chosen' defined in zephyr/dts/common/skeleton.dtsi:13 */
	chosen {
		zephyr,sram = &sram0;            /* in zephyr/boards/raspberrypi/rpi_5/rpi_5.dts:23 */
		zephyr,console = &uart10;        /* in zephyr/boards/raspberrypi/rpi_5/rpi_5.dts:24 */
		zephyr,shell-uart = &uart10;     /* in zephyr/boards/raspberrypi/rpi_5/rpi_5.dts:25 */
		zephyr,pcie-controller = &pcie1; /* in zephyr/boards/raspberrypi/rpi_5/rpi_5.dts:26 */
		zephyr,entropy = &rng;           /* in zephyr/boards/raspberrypi/rpi_5/rpi_5.dts:27 */
	};

	/* node '/aliases' defined in zephyr/dts/common/skeleton.dtsi:15 */
	aliases {
		led0 = &led_act; /* in zephyr/boards/raspberrypi/rpi_5/rpi_5.dts:19 */
	};

	/* node '/soc' defined in zephyr/dts/arm64/armv8-a.dtsi:10 */
	soc {
		compatible = "simple-bus"; /* in zephyr/dts/arm64/armv8-a.dtsi:13 */
		ranges;                    /* in zephyr/dts/arm64/armv8-a.dtsi:14 */
		#address-cells = < 0x2 >;  /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:37 */
