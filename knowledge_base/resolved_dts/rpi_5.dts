		/* node '/soc/memory@200000' defined in zephyr/dts/arm64/broadcom/bcm2712.dtsi:40 */
		sram0: memory@200000 {
			device_type = "memory";         /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:41 */
			compatible = "mmio-sram";       /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:42 */
			reg = < 0x0 0x200000 0x80000 >; /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:43 */
		};

		/* node '/soc/interrupt-controller@107fff9000' defined in zephyr/dts/arm64/broadcom/bcm2712.dtsi:46 */
		gic: interrupt-controller@107fff9000 {
			compatible = "arm,gic-v2",
			             "arm,gic";           /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:47 */
			reg = < 0x10 0x7fff9000 0x1000 >,
			      < 0x10 0x7fffa000 0x2000 >; /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:48 */
			interrupt-controller;             /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:50 */
			#interrupt-cells = < 0x4 >;       /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:51 */
			status = "okay";                  /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:52 */
			phandle = < 0x1 >;                /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:22 */
		};

		/* node '/soc/rng@107d208000' defined in zephyr/dts/arm64/broadcom/bcm2712.dtsi:55 */
		rng: rng@107d208000 {
			compatible = "brcm,iproc-rng200"; /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:56 */
			reg = < 0x10 0x7d208000 0x28 >;   /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:57 */
			status = "okay";                  /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:58 */
		};

		/* node '/soc/gpio2@107d517c00' defined in zephyr/dts/arm64/broadcom/bcm2712.dtsi:61 */
		gpio2@107d517c00 {
			compatible = "simple-bus";      /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:62 */
			reg = < 0x10 0x7d517c00 0x40 >; /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:63 */
			#address-cells = < 0x1 >;       /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:65 */
			#size-cells = < 0x0 >;          /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:66 */

			/* node '/soc/gpio2@107d517c00/gpio@0' defined in zephyr/dts/arm64/broadcom/bcm2712.dtsi:68 */
			gio_aon: gpio@0 {
				compatible = "brcm,brcmstb-gpio"; /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:69 */
				reg = < 0x0 >;                    /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:70 */
				gpio-controller;                  /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:71 */
				#gpio-cells = < 0x2 >;            /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:72 */
				ngpios = < 0x11 >;                /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:73 */
				status = "okay";                  /* in zephyr/boards/raspberrypi/rpi_5/rpi_5.dts:41 */
				phandle = < 0x3 >;                /* in zephyr/boards/raspberrypi/rpi_5/rpi_5.dts:34 */
			};
