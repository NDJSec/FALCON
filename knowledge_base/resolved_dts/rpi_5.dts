		/* node '/soc/serial@107d001000' defined in zephyr/dts/arm64/broadcom/bcm2712.dtsi:78 */
		uart10: serial@107d001000 {
			compatible = "arm,pl011";           /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:79 */
			reg = < 0x10 0x7d001000 0x200 >;    /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:80 */
			interrupts = < 0x0 0x79 0x2 0xa0 >; /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:81 */
			interrupt-names = "irq_121";        /* in zephyr/dts/arm64/broadcom/bcm2712.dtsi:83 */
