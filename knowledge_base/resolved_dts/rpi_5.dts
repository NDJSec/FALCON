			status = "okay";                    /* in zephyr/boards/raspberrypi/rpi_5/rpi_5.dts:45 */
			current-speed = < 0x1c200 >;        /* in zephyr/boards/raspberrypi/rpi_5/rpi_5.dts:46 */
		};
