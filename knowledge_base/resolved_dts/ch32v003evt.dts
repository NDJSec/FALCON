	/* node '/clocks' defined in zephyr/dts/riscv/wch/ch32v0/ch32v003.dtsi:17 */
	clocks {

		/* node '/clocks/clk-hse' defined in zephyr/dts/riscv/wch/ch32v0/ch32v003.dtsi:18 */
		clk_hse: clk-hse {
