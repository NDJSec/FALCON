			compatible = "wch,ch32v00x-pll-clock"; /* in zephyr/dts/riscv/wch/ch32v0/ch32v003.dtsi:40 */
			clocks = < &clk_hse >;                 /* in zephyr/boards/wch/ch32v003evt/ch32v003evt.dts:63 */
