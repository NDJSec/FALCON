	/* node '/cpus' defined in zephyr/dts/arm/silabs/sim3u.dtsi:16 */
	cpus {
		#address-cells = < 0x1 >; /* in zephyr/dts/arm/silabs/sim3u.dtsi:17 */
		#size-cells = < 0x0 >;    /* in zephyr/dts/arm/silabs/sim3u.dtsi:18 */

		/* node '/cpus/cpu@0' defined in zephyr/dts/arm/silabs/sim3u.dtsi:20 */
		cpu0: cpu@0 {
			compatible = "arm,cortex-m3";    /* in zephyr/dts/arm/silabs/sim3u.dtsi:21 */
			device_type = "cpu";             /* in zephyr/dts/arm/silabs/sim3u.dtsi:22 */
			reg = < 0x0 >;                   /* in zephyr/dts/arm/silabs/sim3u.dtsi:24 */
			clock-frequency = < 0x4963800 >; /* in zephyr/boards/gardena/sgrm/sgrm.dts:25 */
		};
	};

	/* node '/memory@20000000' defined in zephyr/dts/arm/silabs/sim3u.dtsi:28 */
	sram0: memory@20000000 {
		compatible = "mmio-sram";    /* in zephyr/dts/arm/silabs/sim3u.dtsi:29 */
		reg = < 0x20000000 0x8000 >; /* in zephyr/dts/arm/silabs/sim3u167.dtsi:22 */
	};

	/* node '/pinctrl' defined in zephyr/dts/arm/silabs/sim3u.dtsi:32 */
	pinctrl: pinctrl {
		compatible = "silabs,si32-pinctrl"; /* in zephyr/dts/arm/silabs/sim3u.dtsi:33 */
		status = "okay";                    /* in zephyr/dts/arm/silabs/sim3u.dtsi:34 */

		/* node '/pinctrl/usart0_default' defined in zephyr/boards/gardena/sgrm/sgrm-pinctrl.dtsi:10 */
		usart0_default: usart0_default {
			phandle = < 0x4 >; /* in zephyr/boards/gardena/sgrm/sgrm.dts:45 */

			/* node '/pinctrl/usart0_default/group1' defined in zephyr/boards/gardena/sgrm/sgrm-pinctrl.dtsi:11 */
			group1 {
				pinmux = < 0x0 >,
				         < 0x800010 >; /* in zephyr/boards/gardena/sgrm/sgrm-pinctrl.dtsi:12 */
				output-enable;         /* in zephyr/boards/gardena/sgrm/sgrm-pinctrl.dtsi:14 */
			};

			/* node '/pinctrl/usart0_default/group2' defined in zephyr/boards/gardena/sgrm/sgrm-pinctrl.dtsi:17 */
			group2 {
				pinmux = < 0x400008 >,
				         < 0xc00018 >; /* in zephyr/boards/gardena/sgrm/sgrm-pinctrl.dtsi:18 */
				input-enable;          /* in zephyr/boards/gardena/sgrm/sgrm-pinctrl.dtsi:20 */
			};
		};

		/* node '/pinctrl/usart1_default' defined in zephyr/boards/gardena/sgrm/sgrm-pinctrl.dtsi:24 */
		usart1_default: usart1_default {
			phandle = < 0x5 >; /* in zephyr/boards/gardena/sgrm/sgrm.dts:52 */

			/* node '/pinctrl/usart1_default/group1' defined in zephyr/boards/gardena/sgrm/sgrm-pinctrl.dtsi:25 */
			group1 {
				pinmux = < 0x2400068 >; /* in zephyr/boards/gardena/sgrm/sgrm-pinctrl.dtsi:26 */
				output-enable;          /* in zephyr/boards/gardena/sgrm/sgrm-pinctrl.dtsi:27 */
			};

			/* node '/pinctrl/usart1_default/group2' defined in zephyr/boards/gardena/sgrm/sgrm-pinctrl.dtsi:30 */
			group2 {
				pinmux = < 0x2800070 >; /* in zephyr/boards/gardena/sgrm/sgrm-pinctrl.dtsi:31 */
				input-enable;           /* in zephyr/boards/gardena/sgrm/sgrm-pinctrl.dtsi:32 */
			};
		};
	};

	/* node '/clocks' defined in zephyr/dts/arm/silabs/sim3u.dtsi:37 */
	clocks {
		#address-cells = < 0x1 >; /* in zephyr/dts/arm/silabs/sim3u.dtsi:38 */
		#size-cells = < 0x0 >;    /* in zephyr/dts/arm/silabs/sim3u.dtsi:39 */

		/* node '/clocks/pll0@4003b000' defined in zephyr/dts/arm/silabs/sim3u.dtsi:41 */
		pll0: pll0@4003b000 {
			compatible = "silabs,si32-pll"; /* in zephyr/dts/arm/silabs/sim3u.dtsi:42 */
			#clock-cells = < 0x0 >;         /* in zephyr/dts/arm/silabs/sim3u.dtsi:43 */
			reg = < 0x4003b000 >;           /* in zephyr/dts/arm/silabs/sim3u.dtsi:44 */
			status = "okay";                /* in zephyr/boards/gardena/sgrm/sgrm.dts:29 */
			phandle = < 0x6 >;              /* in zephyr/boards/gardena/sgrm/sgrm.dts:33 */
		};

		/* node '/clocks/clk-ahb' defined in zephyr/dts/arm/silabs/sim3u.dtsi:48 */
		clk_ahb: clk-ahb {
			compatible = "silabs,si32-ahb"; /* in zephyr/dts/arm/silabs/sim3u.dtsi:49 */
			#clock-cells = < 0x0 >;         /* in zephyr/dts/arm/silabs/sim3u.dtsi:50 */
			clocks = < &pll0 >;             /* in zephyr/boards/gardena/sgrm/sgrm.dts:33 */
			status = "okay";                /* in zephyr/boards/gardena/sgrm/sgrm.dts:34 */
			phandle = < 0x7 >;              /* in zephyr/dts/arm/silabs/sim3u.dtsi:58 */
		};

		/* node '/clocks/clk-apb' defined in zephyr/dts/arm/silabs/sim3u.dtsi:54 */
		clk_apb: clk-apb {
			compatible = "silabs,si32-apb"; /* in zephyr/dts/arm/silabs/sim3u.dtsi:55 */
			#clock-cells = < 0x0 >;         /* in zephyr/dts/arm/silabs/sim3u.dtsi:56 */
			clocks = < &clk_ahb >;          /* in zephyr/dts/arm/silabs/sim3u.dtsi:58 */
			divider = < 0x2 >;              /* in zephyr/boards/gardena/sgrm/sgrm.dts:38 */
			status = "okay";                /* in zephyr/boards/gardena/sgrm/sgrm.dts:39 */
			phandle = < 0x3 >;              /* in zephyr/dts/arm/silabs/sim3u.dtsi:104 */
		};
	};
};
