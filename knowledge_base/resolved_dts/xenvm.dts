/dts-v1/;

/* node '/' defined in zephyr/dts/common/skeleton.dtsi:9 */
/ {
	model = "XENVM";             /* in zephyr/boards/xen/xenvm/xenvm.dts:21 */
	compatible = "xen,xenvm";    /* in zephyr/boards/xen/xenvm/xenvm.dts:22 */
	interrupt-parent = < &gic >; /* in zephyr/boards/xen/xenvm/xenvm.dts:23 */
	#address-cells = < 0x2 >;    /* in zephyr/boards/xen/xenvm/xenvm.dts:24 */
	#size-cells = < 0x2 >;       /* in zephyr/boards/xen/xenvm/xenvm.dts:25 */

	/* node '/chosen' defined in zephyr/dts/common/skeleton.dtsi:13 */
	chosen {
		zephyr,sram = &ram;        /* in zephyr/boards/xen/xenvm/xenvm.dts:28 */
		zephyr,console = &xen_hvc; /* in zephyr/boards/xen/xenvm/xenvm.dts:29 */
	};

	/* node '/aliases' defined in zephyr/dts/common/skeleton.dtsi:15 */
	aliases {
	};

	/* node '/soc' defined in zephyr/dts/arm64/armv8-a.dtsi:10 */
	soc {
		#address-cells = < 0x1 >;  /* in zephyr/dts/arm64/armv8-a.dtsi:11 */
		#size-cells = < 0x1 >;     /* in zephyr/dts/arm64/armv8-a.dtsi:12 */
		compatible = "simple-bus"; /* in zephyr/dts/arm64/armv8-a.dtsi:13 */
		ranges;                    /* in zephyr/dts/arm64/armv8-a.dtsi:14 */
	};

	/* node '/cpus' defined in zephyr/boards/xen/xenvm/xenvm.dts:32 */
	cpus {
		#address-cells = < 0x1 >; /* in zephyr/boards/xen/xenvm/xenvm.dts:33 */
		#size-cells = < 0x0 >;    /* in zephyr/boards/xen/xenvm/xenvm.dts:34 */

		/* node '/cpus/cpu@0' defined in zephyr/boards/xen/xenvm/xenvm.dts:36 */
		cpu@0 {
			device_type = "cpu";      /* in zephyr/boards/xen/xenvm/xenvm.dts:37 */
			compatible = "arm,armv8"; /* in zephyr/boards/xen/xenvm/xenvm.dts:38 */
			enable-method = "psci";   /* in zephyr/boards/xen/xenvm/xenvm.dts:39 */
			reg = < 0x0 >;            /* in zephyr/boards/xen/xenvm/xenvm.dts:40 */
		};
