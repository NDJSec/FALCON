	/* node '/psci' defined in zephyr/boards/xen/xenvm/xenvm.dts:44 */
	psci {
		compatible = "arm,psci-1.0",
		             "arm,psci-0.2",
		             "arm,psci";     /* in zephyr/boards/xen/xenvm/xenvm.dts:45 */
		method = "hvc";              /* in zephyr/boards/xen/xenvm/xenvm.dts:46 */
	};

	/* node '/memory@40000000' defined in zephyr/boards/xen/xenvm/xenvm.dts:49 */
	ram: memory@40000000 {
		device_type = "mmio-sram";              /* in zephyr/boards/xen/xenvm/xenvm.dts:50 */
		reg = < 0x0 0x40000000 0x0 0x1000000 >; /* in zephyr/boards/xen/xenvm/xenvm.dts:51 */
	};

	/* node '/interrupt-controller@3001000' defined in zephyr/boards/xen/xenvm/xenvm.dts:54 */
	gic: interrupt-controller@3001000 {
		compatible = "arm,gic-v2",
