		#interrupt-cells = < 0x4 >;                                  /* in zephyr/boards/xen/xenvm/xenvm.dts:56 */
		#address-cells = < 0x0 >;                                    /* in zephyr/boards/xen/xenvm/xenvm.dts:57 */
		interrupt-controller;                                        /* in zephyr/boards/xen/xenvm/xenvm.dts:58 */
		reg = < 0x0 0x3001000 0x0 0x1000 0x0 0x3002000 0x0 0x2000 >; /* in zephyr/boards/xen/xenvm/xenvm.dts:59 */
		phandle = < 0x1 >;                                           /* in zephyr/boards/xen/xenvm/xenvm.dts:23 */
	};

	/* node '/timer' defined in zephyr/boards/xen/xenvm/xenvm.dts:62 */
	timer {
		compatible = "arm,armv8-timer";                                      /* in zephyr/boards/xen/xenvm/xenvm.dts:63 */
		interrupts = < 0x1 0xd 0x2 0xa0 0x1 0xe 0x2 0xa0 0x1 0xb 0x2 0xa0 >; /* in zephyr/boards/xen/xenvm/xenvm.dts:64 */
		interrupt-parent = < &gic >;                                         /* in zephyr/boards/xen/xenvm/xenvm.dts:67 */
