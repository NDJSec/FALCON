		reg = < 0x0 0x38000000 0x0 0x1000000 >; /* in zephyr/boards/xen/xenvm/xenvm.dts:72 */
		interrupts = < 0x1 0xf 0x4 0xa0 >;      /* in zephyr/boards/xen/xenvm/xenvm.dts:73 */
		interrupt-parent = < &gic >;            /* in zephyr/boards/xen/xenvm/xenvm.dts:74 */
	};

