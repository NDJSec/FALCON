                  <value>#0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Counting direction is increasing (FTM counter increment).</description>
                  <value>#1</value>
                </enumeratedValue>
              </enumeratedValues>
