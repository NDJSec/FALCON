        <value>95</value>
      </interrupt>
      <interrupt>
        <name>CAN1_Error</name>
        <value>96</value>
      </interrupt>
      <interrupt>
        <name>CAN1_Tx_Warning</name>
        <value>97</value>
      </interrupt>
      <interrupt>
        <name>CAN1_Rx_Warning</name>
        <value>98</value>
