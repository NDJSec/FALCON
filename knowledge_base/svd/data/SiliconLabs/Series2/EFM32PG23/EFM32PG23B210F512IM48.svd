                <enumeratedValue>
                  <name>HALFWORD</name>
                  <description>Each unit transfer is a half-word</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WORD</name>
                  <description>Each unit transfer is a word</description>
                  <value>2</value>
