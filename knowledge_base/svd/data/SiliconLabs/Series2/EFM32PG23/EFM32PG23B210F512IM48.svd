                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SAMPLETRAILING</name>
                  <description>Data is set-up on the leading edge and sampled on the trailing edge of the bus clock in synchronous mode</description>
                  <value>1</value>
