                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Output from the transmitter is inverted before it is passed to UARTn_TX</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
