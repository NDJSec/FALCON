                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>The receiver is connected to and receives data from UARTn_TX</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
