                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Addresses that are not automatically NACK'ed, and all data is automatically acknowledged.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
