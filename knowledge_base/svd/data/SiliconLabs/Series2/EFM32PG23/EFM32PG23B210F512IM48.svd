                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>The leader automatically sends a STOP when no more data is available for transmission.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
