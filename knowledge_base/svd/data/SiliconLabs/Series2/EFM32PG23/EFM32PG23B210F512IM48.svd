                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>The CTS pin is active high</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
