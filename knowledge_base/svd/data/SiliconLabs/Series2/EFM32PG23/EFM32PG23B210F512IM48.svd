              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CRC32</name>
                  <description>CRC-32 (0x04C11DB7) polynomial selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CRC16</name>
                  <description>16-bit CRC programmable polynomial selected</description>
