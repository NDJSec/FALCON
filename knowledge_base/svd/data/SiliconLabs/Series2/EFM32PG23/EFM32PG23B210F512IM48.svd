                <enumeratedValue>
                  <name>NORMAL</name>
                  <description>No reverse</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REVERSED</name>
                  <description>Reverse bit order in each byte</description>
                  <value>1</value>
