                </enumeratedValue>
                <enumeratedValue>
                  <name>MSK</name>
                  <description>Minimum Shift Keying</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OOKASK</name>
                  <description>On Off Keying and Amplitude Shift Keying</description>
                  <value>6</value>
                </enumeratedValue>
