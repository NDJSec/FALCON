                  <description>24 bit (3 Bytes) CRC code</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CRCWIDTH32</name>
                  <description>32 bit (4 Bytes) CRC code</description>
                  <value>3</value>
