                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>START_TRIGGER</name>
                  <description>Counting starts when the start-trigger event occurs</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>STOPMODE</name>
              <description>Stop Mode</description>
