                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AUTOSTARTEN</name>
                  <description>Auto start is enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
