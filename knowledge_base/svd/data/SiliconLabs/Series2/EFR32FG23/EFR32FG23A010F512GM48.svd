                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>An incoming frame with the 9th bit equal to MPAB will be loaded into the receive buffer regardless of RXBLOCK and  will result in the MPAB interrupt flag being set</description>
                  <value>1</value>
                </enumeratedValue>
