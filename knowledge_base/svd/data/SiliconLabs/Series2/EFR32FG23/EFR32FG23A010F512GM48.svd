                <enumeratedValue>
                  <name>BIT1</name>
                  <description>1 bit</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BIT2</name>
                  <description>2 bits</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
