                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ASYMMETRIC</name>
                  <description>Nlow=6 and Nhigh=3, and the Nlow:Nhigh ratio is 6:3</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FAST</name>
                  <description>Nlow=11 and Nhigh=6, and the Nlow:Nhigh ratio is 11:6</description>
