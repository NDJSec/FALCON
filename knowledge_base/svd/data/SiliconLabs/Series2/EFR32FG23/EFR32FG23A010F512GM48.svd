                <enumeratedValue>
                  <name>START_TRIGGER</name>
                  <description>Playback event occurs at every start-trigger event</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMED</name>
                  <description>Playback event occurs based on rate defined in PLAYBACL_RATE_CTRL</description>
                  <value>1</value>
