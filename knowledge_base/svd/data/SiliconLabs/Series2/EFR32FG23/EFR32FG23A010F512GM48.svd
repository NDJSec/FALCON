                  <description>Stops clocking and resets peripheral core logic.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enables clocking, and begins scanning if CFG.AUTOSTART is 0x1.</description>
