                <enumeratedValue>
                  <name>DEL16</name>
                  <description>16 baud delay</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DEL32</name>
                  <description>32 baud delay</description>
                  <value>3</value>
