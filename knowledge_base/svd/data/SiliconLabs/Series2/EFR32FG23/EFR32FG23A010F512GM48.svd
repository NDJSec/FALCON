                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REVERSED</name>
                  <description>The most significant byte of the CRC register is transferred first over air via the Frame Controller.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BITREVERSE</name>
