              <enumeratedValues>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Compensation is disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PRELOCK</name>
                  <description>Compensation locks when preamble is detected.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
