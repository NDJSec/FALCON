          <resetMask>0x8000808F</resetMask>
          <fields>
            <field>
              <name>DBGHALT</name>
              <description>Debug halt</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
