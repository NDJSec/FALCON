    <peripheral>
      <name>GPCRC_S</name>
      <version>0</version>
      <description>GPCRC_S Registers</description>
      <baseAddress>0x40088000</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>0x00001000</size>
