                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HISPD4</name>
                  <description>High speed over sampling of 4x. </description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HISPD8</name>
                  <description>High speed over sampling of 8x.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HISPD16</name>
                  <description>High speed over sampling of 16x.</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HISPD32</name>
