                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>When a general call address is received, a software response is required</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
