                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REDUCED</name>
                  <description>It is recommended to use this setting when the input to the comparator core will always be less than AVDD-0.7V.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
