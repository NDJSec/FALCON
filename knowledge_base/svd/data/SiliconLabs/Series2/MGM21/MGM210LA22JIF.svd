                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VALID2</name>
                  <description>When 2 entries in the scan FIFO are valid, set the SCANFIFODVL interrupt and request DMA.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VALID3</name>
