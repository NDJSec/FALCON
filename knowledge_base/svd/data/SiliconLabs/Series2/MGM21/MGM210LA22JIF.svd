                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>The USn_CTS pin is high true</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
