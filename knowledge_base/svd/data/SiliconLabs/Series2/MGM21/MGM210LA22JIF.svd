                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MSBFIRST</name>
                  <description>The most significant data bit is first input to the CRC generator.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
